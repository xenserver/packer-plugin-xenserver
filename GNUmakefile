NAME=xenserver
BINARY=packer-plugin-${NAME}

COUNT?=1
RACE?=-race
TEST?=$(shell go list ./...)
HASHICORP_PACKER_PLUGIN_SDK_VERSION?=$(shell go list -m github.com/hashicorp/packer-plugin-sdk | cut -d " " -f2)

.PHONY: dev

build:
	@go build -o ${BINARY}

dev: build
	@mkdir -p ~/.packer.d/plugins/
	@mv ${BINARY} ~/.packer.d/plugins/${BINARY}

test:
	@go test $(RACE) -count $(COUNT) $(TEST) -timeout=3m

install-packer-sdc: ## Install the packer-sdc (packer software development command) tool
	@go install github.com/hashicorp/packer-plugin-sdk/cmd/packer-sdc@${HASHICORP_PACKER_PLUGIN_SDK_VERSION}

# Render the docs (expanding @include partials) and package them for a release.
ci-release-docs: install-packer-sdc
	@rm -rf .docs
	@packer-sdc renderdocs -src docs -partials docs-partials/ -dst .docs/
	@rm -f docs.zip
	@/bin/sh -c "[ -d .docs ] && (cd .docs && zip -r ../docs.zip .)"
	@rm -r ".docs"

plugin-check: install-packer-sdc build
	@packer-sdc plugin-check ${BINARY}

testacc: dev
	@PACKER_ACC=1 go test -count $(COUNT) -v $(TEST) -timeout=120m

# Regenerate all generated code and docs:
#   1. go generate ./...     -> struct-markdown partials + hcl2spec
#   2. renderdocs            -> expand @include directives into .docs/
#   3. compile-to-webdocs.sh -> transform .docs/ into the .web-docs/ layout
#   4. stamp a DO-NOT-EDIT banner onto the .web-docs output
# See README.md "Documentation: generated vs hand-written" for which files
# under docs/, docs-partials/ and .web-docs/ are sources and which are output.
generate: install-packer-sdc
	@go generate ./...
	@$(MAKE) --no-print-directory stamp-generated-go
	@rm -rf .docs
	@packer-sdc renderdocs -src docs -partials docs-partials/ -dst .docs/
	@./.web-docs/scripts/compile-to-webdocs.sh "." ".docs" ".web-docs" "xenserver"
	@rm -r ".docs"
	@$(MAKE) --no-print-directory stamp-webdocs

# packer-sdc drops the copyright header from the Go files it generates; put it back.
stamp-generated-go:
	@find builder -name '*.hcl2spec.go' | while read -r f; do \
		head -1 "$$f" | grep -q 'Citrix Systems' || { \
			printf '%s\n\n' \
				'// Copyright (c) 2026. Citrix Systems, Inc.' \
				| cat - "$$f" > "$$f.tmp" && mv "$$f.tmp" "$$f"; \
		}; \
	done

# Mark the .web-docs READMEs as generated. Done here, not in compile-to-webdocs.sh,
# to keep that script close to upstream.
stamp-webdocs:
	@find .web-docs -name '*.md' | while read -r f; do \
		head -1 "$$f" | grep -q 'DO NOT EDIT' || { \
			printf '%s\n%s\n\n' \
				'<!-- Code generated by "make generate"; DO NOT EDIT MANUALLY. -->' \
				'<!-- Edit the sources under docs/ and docs-partials/xenserver/ instead. -->' \
				| cat - "$$f" > "$$f.tmp" && mv "$$f.tmp" "$$f"; \
		}; \
	done
